    "title": "Prueba de tres workers a la vez",
    "vision": "Comprobar que el bucle desatendido lanza tres workers de código a la vez sin pasar de tres.",
    "language": "es",
    "delivery": {
      "mode": "manual"
    },
    "summary": "Tres contextos independientes con una ruta de saludo cada uno (#703 del harness).",
    "requirements": [
      {
        "id": "RQ.001",
        "title": "Cada contexto responde a su ruta de saludo",
        "type": "Funcional",
        "source": "harness#703"
      }
    ],
    "conventions": {
      "areas": {
        "PAR": "Paralelismo"
      }
    }
  },
