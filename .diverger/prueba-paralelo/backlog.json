  "stories": [
    {
      "id": "HU-PAR-01",
      "kind": "story",
      "epic": "EP-01",
      "title": "Saludo del contexto Alfa",
      "role": "empleado",
      "goal": "pedir el saludo del contexto Alfa",
      "benefit": "comprobar que el contexto responde",
      "requirements": [
        "RQ.001"
      ],
      "acceptanceCriteria": [
        {
          "type": "positive",
          "given": "la empleada «ana.perez@empresa.com» con sesión iniciada",
          "when": "pide GET /api/alfa/saludo",
          "then": "recibe 200 con {\"contexto\": \"alfa\", \"persona\": \"ana.perez@empresa.com\"}"
        },
        {
          "type": "negative",
          "given": "una petición sin token",
          "when": "pide GET /api/alfa/saludo",
          "then": "recibe 401 con {\"error\": \"Inicia sesión con Google.\"}"
        }
      ],
      "priority": "must",
      "estimate": {
        "size": "S",
        "hours": 1
      },
      "storyPoints": 1,
      "status": "approved",
      "sprint": "SP-01",
      "blockedBy": [],
      "context": "Prueba del paralelismo (#703 del harness): el contexto alfa no depende de ningún otro.",
      "notes": "",
      "definitionOfDone": "Criterios de aceptación probados."
    },
