{
  "mode": "yolo",
  "default_provider": "github",
  "conventions": {
    "idScheme": "area",
    "kinds": [
      "story",
      "enabler"
    ],
    "disciplines": [
      "data",
      "backend",
      "frontend",
      "qa"
    ],
    "estimation": "points+hours",
    "priorityScale": "jira",
    "requirementPrefix": "RQ.",
    "sprintZero": true
  },
  "maxCodeWorkers": 3,
  "authorizations": [
    "publish:github"
  ],
  "default_repo": "DivergerThinking/diverger-nivel-1",
  "github": {
    "projectTitle": "Nivel 1 · ejecución {run}"
  }
}
