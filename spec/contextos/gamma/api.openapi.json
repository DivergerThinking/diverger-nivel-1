{
  "openapi": "3.1.0",
  "info": {
    "title": "Contexto Gamma",
    "version": "1.0.0",
    "description": "Saludo del contexto gamma (prueba de paralelismo, harness#703)."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "google": []
    }
  ],
  "paths": {
    "/api/gamma/saludo": {
      "get": {
        "operationId": "saludoGamma",
        "summary": "Saludo del contexto gamma para la persona que ha iniciado sesión",
        "responses": {
          "200": {
            "description": "Saludo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saludo"
                }
              }
            }
          },
          "401": {
            "description": "Falta el inicio de sesión o el token no es válido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "google": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de identidad de Google (Google Identity Services)"
      }
    },
    "schemas": {
      "Saludo": {
        "type": "object",
        "required": [
          "contexto",
          "persona"
        ],
        "properties": {
          "contexto": {
            "type": "string",
            "const": "gamma"
          },
          "persona": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
