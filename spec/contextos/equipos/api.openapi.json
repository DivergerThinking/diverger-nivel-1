{
  "openapi": "3.1.0",
  "info": {
    "title": "Equipos",
    "version": "1.0.0",
    "description": "Alta de equipos. Ruta, campos, códigos y mensajes de la API fijada por el cliente (ADR 0001)."
  },
  "paths": {
    "/api/equipos": {
      "post": {
        "operationId": "equipos.crearEquipo",
        "summary": "Dar de alta un equipo (Solo IT)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NuevoEquipo" },
              "example": { "nombre": "Portátil 07" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Equipo dado de alta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EquipoCreado" },
                "example": { "id": "…", "nombre": "Portátil 07", "estado": "disponible" }
              }
            }
          },
          "400": {
            "description": "«Falta el nombre del equipo» si el nombre falta o está vacío",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Falta el nombre del equipo" }
              }
            }
          },
          "401": {
            "description": "Sin token válido: «Inicia sesión con Google.»",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Inicia sesión con Google." }
              }
            }
          },
          "403": {
            "description": "La cuenta no es de IT: «Solo IT puede hacer esto.»",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Solo IT puede hacer esto." }
              }
            }
          },
          "409": {
            "description": "«Ya hay un equipo con ese nombre»",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Ya hay un equipo con ese nombre" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NuevoEquipo": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string" }
        }
      },
      "EquipoCreado": {
        "type": "object",
        "required": ["id", "nombre", "estado"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "estado": { "type": "string", "const": "disponible" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      }
    }
  }
}
