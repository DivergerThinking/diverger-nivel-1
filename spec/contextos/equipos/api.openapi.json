{
  "openapi": "3.1.0",
  "info": {
    "title": "Equipos",
    "version": "1.0.0",
    "description": "Alta de los equipos de la oficina. Ruta, campos, códigos y mensajes fijados por el cliente (ADR 0002)."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "google": [] }],
  "paths": {
    "/api/equipos": {
      "post": {
        "operationId": "equipos.crearEquipo",
        "summary": "Dar de alta un equipo (solo IT)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NuevoEquipo" },
              "example": { "nombre": "Portátil 07" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Equipo dado de alta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Equipo" },
                "example": { "id": "…", "nombre": "Portátil 07", "estado": "disponible" }
              }
            }
          },
          "400": {
            "description": "El nombre falta o está vacío",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Falta el nombre del equipo" }
              }
            }
          },
          "401": {
            "description": "Sin un token válido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Inicia sesión con Google." }
              }
            }
          },
          "403": {
            "description": "La cuenta no es de IT",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Solo IT puede hacer esto." }
              }
            }
          },
          "409": {
            "description": "Ya hay un equipo con ese nombre",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Ya hay un equipo con ese nombre" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "google": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de identidad de Google con el correo verificado, emitido para el cliente OAuth de la aplicación, de una persona o de una cuenta de servicio."
      }
    },
    "schemas": {
      "NuevoEquipo": {
        "type": "object",
        "properties": { "nombre": { "type": "string" } }
      },
      "Equipo": {
        "type": "object",
        "required": ["id", "nombre", "estado"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "estado": { "type": "string", "const": "disponible" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
