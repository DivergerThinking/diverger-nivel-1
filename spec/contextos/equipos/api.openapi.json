{
  "openapi": "3.1.0",
  "info": {
    "title": "Equipos",
    "version": "1.0.0",
    "description": "Alta de los equipos que se prestan. Sigue la API fijada por el cliente (ADR 0001)."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "google": [] }],
  "paths": {
    "/api/equipos": {
      "post": {
        "operationId": "equipos.crearEquipo",
        "summary": "Dar de alta un equipo (solo IT)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EquipoNuevo" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Equipo dado de alta, disponible",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EquipoCreado" }
              }
            }
          },
          "400": {
            "description": "Falta el nombre del equipo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Falta el nombre del equipo" }
              }
            }
          },
          "401": {
            "description": "Sin un token válido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Inicia sesión con Google." }
              }
            }
          },
          "403": {
            "description": "La cuenta no es de IT",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Solo IT puede hacer esto." }
              }
            }
          },
          "409": {
            "description": "Ya hay un equipo con ese nombre",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Ya hay un equipo con ese nombre" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "google": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "EquipoNuevo": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string", "examples": ["Portátil 07"] }
        }
      },
      "EquipoCreado": {
        "type": "object",
        "required": ["id", "nombre", "estado"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "estado": { "type": "string", "const": "disponible" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      }
    }
  }
}
