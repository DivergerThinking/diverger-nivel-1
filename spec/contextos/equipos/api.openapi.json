{
  "openapi": "3.1.0",
  "info": { "title": "Equipos", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "security": [{ "google": [] }],
  "paths": {
    "/api/equipos": {
      "post": {
        "operationId": "equipos.crearEquipo",
        "summary": "Dar de alta un equipo (Solo IT)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AltaEquipo" },
              "example": { "nombre": "Portátil 07" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Equipo dado de alta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EquipoNuevo" },
                "example": { "id": "…", "nombre": "Portátil 07", "estado": "disponible" }
              }
            }
          },
          "400": {
            "description": "El nombre falta o está vacío",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Falta el nombre del equipo" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SinSesion" },
          "403": { "$ref": "#/components/responses/SoloIt" },
          "409": {
            "description": "Ya hay un equipo con ese nombre",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Ya hay un equipo con ese nombre" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "google": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "schemas": {
      "AltaEquipo": {
        "type": "object",
        "properties": { "nombre": { "type": "string" } }
      },
      "EquipoNuevo": {
        "type": "object",
        "required": ["id", "nombre", "estado"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "estado": { "type": "string", "const": "disponible" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    },
    "responses": {
      "SinSesion": {
        "description": "Sin un token válido",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Inicia sesión con Google." }
          }
        }
      },
      "SoloIt": {
        "description": "La cuenta no es de IT",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Solo IT puede hacer esto." }
          }
        }
      }
    }
  }
}
