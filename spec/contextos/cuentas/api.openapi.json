{
  "openapi": "3.1.0",
  "info": {
    "title": "Cuentas",
    "version": "1.0.0",
    "description": "Cuenta de la sesión. Operación auxiliar que no está en la API fijada por el cliente; usa su mismo formato de error."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "google": [] }],
  "paths": {
    "/api/cuentas/yo": {
      "get": {
        "operationId": "cuentas.consultarCuenta",
        "summary": "Devuelve el correo de la sesión y si es una cuenta de IT",
        "responses": {
          "200": {
            "description": "Cuenta de la sesión",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cuenta" } } }
          },
          "401": { "$ref": "#/components/responses/SinSesion" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "google": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Token de identidad de Google con el correo verificado, emitido para el cliente OAuth de la aplicación." }
    },
    "responses": {
      "SinSesion": {
        "description": "Sin un token válido",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Inicia sesión con Google." }
          }
        }
      }
    },
    "schemas": {
      "Cuenta": {
        "type": "object",
        "required": ["correo", "esIT"],
        "properties": {
          "correo": { "type": "string" },
          "esIT": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
