{
  "openapi": "3.1.0",
  "info": { "title": "Cuentas", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "security": [{ "google": [] }],
  "paths": {
    "/api/cuentas/yo": {
      "get": {
        "operationId": "cuentas.obtenerSesion",
        "summary": "La persona de la sesión y si es una cuenta de IT",
        "responses": {
          "200": {
            "description": "La persona de la sesión",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sesion" } } }
          },
          "401": { "$ref": "#/components/responses/SinSesion" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "google": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "schemas": {
      "Sesion": {
        "type": "object",
        "required": ["email", "esIt"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "esIt": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    },
    "responses": {
      "SinSesion": {
        "description": "Sin un token válido",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Inicia sesión con Google." }
          }
        }
      }
    }
  }
}
