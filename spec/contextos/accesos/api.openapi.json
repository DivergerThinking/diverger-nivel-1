{
  "openapi": "3.1.0",
  "info": {
    "title": "Accesos",
    "version": "1.0.0",
    "description": "Sesión de quien hace la petición. Los errores usan el formato de la API fijada por el cliente (ADR 0001)."
  },
  "paths": {
    "/api/accesos/sesion": {
      "get": {
        "operationId": "accesos.consultarSesion",
        "summary": "Devuelve la persona de la sesión y si su cuenta es de IT",
        "responses": {
          "200": {
            "description": "Sesión de quien hace la petición",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Sesion" }
              }
            }
          },
          "401": {
            "description": "Sin token válido: «Inicia sesión con Google.»",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Inicia sesión con Google." }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Sesion": {
        "type": "object",
        "required": ["persona", "esIT"],
        "properties": {
          "persona": { "type": "string", "description": "Correo del token" },
          "esIT": { "type": "boolean", "description": "Si el correo está en la lista de IT (CORREOS_IT)" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      }
    }
  }
}
