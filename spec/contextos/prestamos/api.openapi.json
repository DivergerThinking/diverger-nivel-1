{
  "openapi": "3.1.0",
  "info": { "title": "Préstamos", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "security": [{ "google": [] }],
  "paths": {
    "/api/equipos": {
      "get": {
        "operationId": "prestamos.listarEquipos",
        "summary": "Ver los equipos (todos)",
        "responses": {
          "200": { "description": "Lista de equipos", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/EstadoEquipo" } } } } },
          "401": { "$ref": "#/components/responses/SinSesion" }
        }
      }
    },
    "/api/equipos/{id}/solicitud": {
      "post": {
        "operationId": "prestamos.solicitarEquipo",
        "summary": "Pedir un equipo (todos)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Solicitud" } } } },
        "responses": {
          "201": { "description": "Equipo reservado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EstadoEquipo" } } } },
          "400": { "description": "Falta la fecha de devolución / La fecha de devolución no es válida / La fecha de devolución ya ha pasado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "examples": { "falta": { "value": { "error": "Falta la fecha de devolución" } }, "invalida": { "value": { "error": "La fecha de devolución no es válida" } }, "pasada": { "value": { "error": "La fecha de devolución ya ha pasado" } } } } } },
          "401": { "$ref": "#/components/responses/SinSesion" },
          "404": { "$ref": "#/components/responses/NoExiste" },
          "409": { "$ref": "#/components/responses/NoDisponible" }
        }
      }
    },
    "/api/equipos/{id}/entrega": {
      "post": {
        "operationId": "prestamos.entregarEquipo",
        "summary": "Entregar un equipo reservado (solo IT)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "Equipo prestado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EstadoEquipo" } } } },
          "401": { "$ref": "#/components/responses/SinSesion" },
          "403": { "$ref": "#/components/responses/SoloIt" },
          "404": { "$ref": "#/components/responses/NoExiste" },
          "409": { "description": "El equipo no está reservado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "El equipo no está reservado" } } } }
        }
      }
    },
    "/api/equipos/{id}/prestamo": {
      "post": {
        "operationId": "prestamos.prestarEquipo",
        "summary": "Prestar en el mostrador (solo IT)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PrestamoMostrador" } } } },
        "responses": {
          "201": { "description": "Equipo prestado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EstadoEquipo" } } } },
          "400": { "description": "Faltan la persona o la fecha de devolución / La fecha de devolución no es válida", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "examples": { "faltan": { "value": { "error": "Faltan la persona o la fecha de devolución" } }, "invalida": { "value": { "error": "La fecha de devolución no es válida" } } } } } },
          "401": { "$ref": "#/components/responses/SinSesion" },
          "403": { "$ref": "#/components/responses/SoloIt" },
          "404": { "$ref": "#/components/responses/NoExiste" },
          "409": { "$ref": "#/components/responses/NoDisponible" }
        }
      }
    },
    "/api/equipos/{id}/devolucion": {
      "post": {
        "operationId": "prestamos.registrarDevolucion",
        "summary": "Apuntar la devolución (solo IT)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "Equipo disponible, sin persona ni devolucion", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EstadoEquipo" } } } },
          "401": { "$ref": "#/components/responses/SinSesion" },
          "403": { "$ref": "#/components/responses/SoloIt" },
          "404": { "$ref": "#/components/responses/NoExiste" },
          "409": { "description": "El equipo no está prestado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "El equipo no está prestado" } } } }
        }
      }
    },
    "/api/prestamos/vencidos": {
      "get": {
        "operationId": "prestamos.listarVencidos",
        "summary": "Ver los préstamos vencidos (solo IT), del más antiguo al más reciente",
        "responses": {
          "200": { "description": "Préstamos vencidos", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Vencido" } } } } },
          "401": { "$ref": "#/components/responses/SinSesion" },
          "403": { "$ref": "#/components/responses/SoloIt" }
        }
      }
    },
    "/api/equipos/{id}/historial": {
      "get": {
        "operationId": "prestamos.obtenerHistorial",
        "summary": "Ver el historial de un equipo (solo IT), del más reciente al más antiguo",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "Préstamos del equipo", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MovimientoHistorial" } } } } },
          "401": { "$ref": "#/components/responses/SinSesion" },
          "403": { "$ref": "#/components/responses/SoloIt" },
          "404": { "$ref": "#/components/responses/NoExiste" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "google": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
    },
    "responses": {
      "SinSesion": { "description": "Inicia sesión con Google.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Inicia sesión con Google." } } } },
      "SoloIt": { "description": "Solo IT puede hacer esto.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Solo IT puede hacer esto." } } } },
      "NoExiste": { "description": "No existe el equipo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "No existe el equipo" } } } },
      "NoDisponible": { "description": "El equipo no está disponible", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "El equipo no está disponible" } } } }
    },
    "schemas": {
      "Fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "Solicitud": { "type": "object", "properties": { "devolucion": { "$ref": "#/components/schemas/Fecha" } } },
      "PrestamoMostrador": { "type": "object", "properties": { "persona": { "type": "string" }, "devolucion": { "$ref": "#/components/schemas/Fecha" } } },
      "EstadoEquipo": {
        "type": "object",
        "required": ["id", "nombre", "estado"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "estado": { "type": "string", "enum": ["disponible", "reservado", "prestado"] },
          "persona": { "type": "string", "description": "Solo si está reservado o prestado" },
          "devolucion": { "$ref": "#/components/schemas/Fecha", "description": "Solo si está reservado o prestado" }
        }
      },
      "Vencido": {
        "type": "object",
        "required": ["id", "nombre", "persona", "devolucion"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "persona": { "type": "string" },
          "devolucion": { "$ref": "#/components/schemas/Fecha" }
        }
      },
      "MovimientoHistorial": {
        "type": "object",
        "required": ["persona", "devolucion", "estado"],
        "properties": {
          "persona": { "type": "string" },
          "devolucion": { "$ref": "#/components/schemas/Fecha" },
          "estado": { "type": "string", "enum": ["reservado", "prestado", "devuelto"] }
        }
      },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } }
    }
  }
}
